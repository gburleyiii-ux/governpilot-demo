    { "id": "HA-3", "level": "L1", "must": true, "class": "black-box", "check": "approval-signed" },
    { "id": "HA-4", "level": "L1", "must": true, "class": "black-box", "check": "no-approval-escalation" },
    { "id": "PC-1", "level": "L1", "must": true, "class": "black-box", "check": "policy-declarative" },
    { "id": "PC-2", "level": "L1", "must": true, "class": "black-box", "check": "policy-rego-export" },

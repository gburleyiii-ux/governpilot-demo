# Local loopback demo (default). MVP can run without provider secrets.
OPENAI_API_KEY=
SENTINELOPS_API_HOST=127.0.0.1
SENTINELOPS_API_PORT=4175
SENTINELOPS_AGENT_MODE=deterministic
SENTINELOPS_SIGNING_SECRET=
VITE_SENTINELOPS_API_BASE=http://127.0.0.1:4175/api
AWS_REGION=us-gov-west-1
SENTINELOPS_MODE=local

# Auth (Aegis C1): local-dev is ONLY allowed on loopback / non-production-like hosts.
# Docker (0.0.0.0 + NODE_ENV=production) and GovCloud MUST use jwt|oidc or boot refuses.
# SENTINELOPS_AUTH_MODE=local-dev
# SENTINELOPS_AUTH_MODE=jwt
# SENTINELOPS_AUTH_JWT_SECRET=
# SENTINELOPS_AUTH_MODE=oidc
# SENTINELOPS_AUTH_JWKS_URL=https://example.com/.well-known/jwks.json
# SENTINELOPS_AUTH_ISSUER=
# SENTINELOPS_AUTH_AUDIENCE=

# Stripe (H3 / Grant hard lock): TEST MODE ONLY. Live money refused this pass.
# Leave unset to disable. Never set STRIPE_MODE=live or *_live_ keys (boot refuses).
# STRIPE_MODE=test
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_test_...
